-    sycl_ext_free(stream, tmp_buf);
 }
 
 static void reorder_qw_q8_0(uint8_t * data_device, size_t size, size_t offset, dpct::queue_ptr stream) {
@@ -3501,7 +3502,7 @@ static void reorder_qw_q8_0(uint8_t * data_device, size_t size, size_t offset, d
 
     const int nblocks = size / sizeof(block_q8_0);
 
-    uint8_t * tmp_buf = static_cast<uint8_t *>(sycl_ext_malloc_device(stream, size));
+    uint8_t * tmp_buf = static_cast<uint8_t *>(reorder_get_scratch(stream, size));
 
     sycl::event copy_event;
     SYCL_CHECK(CHECK_TRY_ERROR(copy_event = stream->memcpy(tmp_buf, data_device, size)));
@@ -3524,7 +3525,6 @@ static void reorder_qw_q8_0(uint8_t * data_device, size_t size, size_t offset, d

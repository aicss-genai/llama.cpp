From b6e177866e89d996d53e67cdb7d0e349074e559a Mon Sep 17 00:00:00 2001
From: unrahul <unrahul@users.noreply.archlinux.org>
Date: Thu, 9 Apr 2026 10:58:37 -0700
Subject: [PATCH 01/10] sycl: remove redundant dpct::has_capability_or_fail
 checks

All Intel GPUs from Gen9+ support FP16. These SYCLomatic-generated
runtime checks add unnecessary overhead per kernel launch (73 call
sites across 11 files). The capability is verified at compile time
via the AOT target specification.

diff --git a/ggml/src/ggml-sycl/binbcast.cpp b/ggml/src/ggml-sycl/binbcast.cpp
index 92dd188..6f0d6a0 100644
--- a/ggml/src/ggml-sycl/binbcast.cpp
+++ b/ggml/src/ggml-sycl/binbcast.cpp
@@ -220,9 +220,6 @@ struct bin_bcast_sycl {
                 // this is the maximum number of blocks in z direction, fallback to 1D grid kernel
                 int block_num = (ne0*ne1*ne2*ne3 + block_size - 1) / block_size;
                 {
-                    dpct::has_capability_or_fail(stream->get_device(),
-                                                 {sycl::aspect::fp16});
-
                     stream->parallel_for(
                         sycl::nd_range<3>(sycl::range<3>(1, 1, block_num) *
                                               sycl::range<3>(1, 1, block_size),
@@ -241,9 +238,6 @@ struct bin_bcast_sycl {
                 info::device::max_work_group_size. Adjust the work-group size if
                 needed.
                 */
-                dpct::has_capability_or_fail(stream->get_device(),
-                                             {sycl::aspect::fp16});
-
                 stream->parallel_for(
                     sycl::nd_range<3>(block_nums * block_dims, block_dims),
                     [=](sycl::nd_item<3> item_ct1) {
